# Headless CMS (Strapi v4). Includes the /api prefix.
NEXT_PUBLIC_CMS_API_URL=https://cms.wearedoble.com/api

# Canonical origin. Drives metadataBase, canonical URLs, hreflang and sitemap.
NEXT_PUBLIC_SITE_URL=https://churroloop.com

# Menu button behaviour: link | soon | hidden
# `link` (the default) opens the menu PDF bundled in public/carta-churroloop.pdf.
NEXT_PUBLIC_MENU_MODE=link
# Only used with NEXT_PUBLIC_MENU_MODE=link. Overrides the bundled PDF.
NEXT_PUBLIC_MENU_URL=
